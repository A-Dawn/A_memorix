          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "v1SearchMode": {
      "type": "string",
      "enum": [
        "SEARCH_MODE_UNSPECIFIED",
        "SEARCH_MODE_SEARCH",
        "SEARCH_MODE_TIME",
        "SEARCH_MODE_HYBRID",
        "SEARCH_MODE_EPISODE",
        "SEARCH_MODE_AGGREGATE"
      ],
      "default": "SEARCH_MODE_UNSPECIFIED"
    }
  }
}
