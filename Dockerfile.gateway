# syntax=docker/dockerfile:1

FROM golang:1.25-alpine AS builder

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY gen ./gen
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/a-memorix-gateway ./cmd/a-memorix-gateway

FROM alpine:3.22 AS runtime

LABEL org.opencontainers.image.source="https://github.com/MaiM-with-u/A_memorix" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.title="A_memorix gRPC-Gateway"

RUN apk add --no-cache ca-certificates wget \
    && addgroup -g 10001 a-memorix \
    && adduser -D -H -u 10001 -G a-memorix a-memorix
COPY --from=builder /out/a-memorix-gateway /usr/local/bin/a-memorix-gateway

USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
    CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
ENTRYPOINT ["/usr/local/bin/a-memorix-gateway"]
CMD ["--listen", "0.0.0.0:8080", "--grpc-target", "server:50051"]
